# Supabase — two connection strings are required.
#
# DATABASE_URL: Supavisor transaction mode (port 6543) for the app at runtime.
#   `pgbouncer=true` is mandatory — without it Prisma emits prepared statements
#   the transaction pooler cannot honour.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: direct/session connection (port 5432) for `prisma db push` and
#   migrations, which need DDL and session state the pooler cannot provide.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

AUTH_SECRET="replace-with-random-secret"
AUTH_URL="http://localhost:3000"

# AI — two providers, split on purpose:
#
# DeepSeek menjalankan Analisis AI Trading. Laporannya per pengguna dan dijual
# per token, jadi biayanya sensitif.
# DEEPSEEK_API_KEY="sk-..."
# DEEPSEEK_MODEL="deepseek-v4-pro"          # opsional, ini nilai bawaannya
# DEEPSEEK_BASE_URL="https://api.deepseek.com"  # opsional

# Claude menjalankan analisis event Kalender Ekonomi. Hasilnya universal —
# sekali generate dipakai semua pengguna — sehingga biayanya jauh lebih kecil.
# ANTHROPIC_API_KEY="sk-ant-..."
